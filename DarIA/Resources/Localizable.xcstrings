    "chat.error.conversationTooLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This conversation is too long for the model. Start a new chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversación es demasiado larga para el modelo. Empieza un chat nuevo."
