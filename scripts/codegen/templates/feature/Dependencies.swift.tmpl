import Foundation

/// Dependency injection container of {{Feature}}: the only place where its concrete types are built.
/// View, ViewModel and UseCase receive it in their `init(dependencies:)` and call the `resolve` functions they need.
@MainActor
final class {{Feature}}Dependencies {
    init() {}

    func resolveUseCase() -> any {{Feature}}UseCaseProtocol {
        {{Feature}}UseCase(dependencies: self)
    }

    func resolveViewModel() -> {{Feature}}ViewModel {
        {{Feature}}ViewModel(dependencies: self)
    }
}
